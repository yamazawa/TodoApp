<UserControl x:Class="TodoApp.Views.TodoListPanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:styles="clr-namespace:TodoApp.Styles"
             xmlns:resx="clr-namespace:TodoApp.Resources"
             xmlns:behaviors="clr-namespace:TodoApp.Behaviors"
             xmlns:i="http://schemas.microsoft.com/xaml/behaviors"
             mc:Ignorable="d"
             x:Name="Root">
    <UserControl.Resources>
        <!-- 子TODOリストのアイテムテンプレート -->
        <!-- 通常はテキスト表示、右クリック「編集」でTextBoxに切り替える -->
        <DataTemplate x:Key="ChildTodoItemTemplate">
            <Grid>
                <TextBlock x:Name="DisplayText"
                           Text="{Binding DisplayTitle}"
                           Padding="{x:Static styles:LayoutConstants.ControlPadding}"
                           Tag="{Binding ElementName=Root}">
                    <TextBlock.ContextMenu>
                        <ContextMenu DataContext="{Binding Path=PlacementTarget.DataContext, RelativeSource={RelativeSource Self}}">
                            <MenuItem Header="{x:Static resx:Strings.Menu_Open}"
                                      Command="{Binding Path=PlacementTarget.Tag.DataContext.OpenChildTodoCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}" />
                            <MenuItem Header="{x:Static resx:Strings.Menu_Edit}"
                                      Command="{Binding StartEditCommand}" />
                            <MenuItem Header="{x:Static resx:Strings.NavigateLink}"
                                      Command="{Binding Path=PlacementTarget.Tag.NavigateToChildCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                      CommandParameter="{Binding}" />
                            <MenuItem Header="{x:Static resx:Strings.Menu_ConvertToMemo}"
                                      Command="{Binding Path=PlacementTarget.Tag.DataContext.ConvertChildTodoToMemoCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}" />
                            <MenuItem Header="{x:Static resx:Strings.Button_Delete}"
                                      Command="{Binding Path=PlacementTarget.Tag.DataContext.DeleteChildTodoCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}" />
                        </ContextMenu>
                    </TextBlock.ContextMenu>
                </TextBlock>
                <TextBox x:Name="EditBox"
                         Text="{Binding Title, UpdateSourceTrigger=PropertyChanged}"
                         Padding="{x:Static styles:LayoutConstants.ControlPadding}"
                         HorizontalAlignment="Stretch"
                         BorderThickness="0" Background="Transparent"
                         Visibility="Collapsed"
                         behaviors:FocusBehavior.IsFocused="{Binding IsEditing}">
                    <i:Interaction.Triggers>
                        <i:EventTrigger EventName="LostFocus">
                            <i:InvokeCommandAction Command="{Binding EndEditCommand}" />
                        </i:EventTrigger>
                    </i:Interaction.Triggers>
                </TextBox>
            </Grid>
            <DataTemplate.Triggers>
                <DataTrigger Binding="{Binding IsEditing}" Value="True">
                    <Setter TargetName="DisplayText" Property="Visibility" Value="Collapsed" />
                    <Setter TargetName="EditBox" Property="Visibility" Value="Visible" />
                </DataTrigger>
            </DataTemplate.Triggers>
        </DataTemplate>

        <!-- メモ情報リストのアイテムテンプレート -->
        <DataTemplate x:Key="MemoItemTemplate">
            <Grid>
                <TextBlock x:Name="DisplayText"
                           Text="{Binding DisplayTitle}"
                           Padding="{x:Static styles:LayoutConstants.ControlPadding}"
                           Tag="{Binding ElementName=Root}">
                    <TextBlock.ContextMenu>
                        <ContextMenu DataContext="{Binding Path=PlacementTarget.DataContext, RelativeSource={RelativeSource Self}}">
                            <MenuItem Header="{x:Static resx:Strings.Menu_Open}"
                                      Command="{Binding Path=PlacementTarget.Tag.DataContext.OpenMemoCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}" />
                            <MenuItem Header="{x:Static resx:Strings.Menu_Edit}"
                                      Command="{Binding StartEditCommand}" />
                            <MenuItem Header="{x:Static resx:Strings.Menu_ConvertToChildTodo}"
                                      Command="{Binding Path=PlacementTarget.Tag.DataContext.ConvertMemoToChildTodoCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}" />
                            <MenuItem Header="{x:Static resx:Strings.Button_Delete}"
                                      Command="{Binding Path=PlacementTarget.Tag.DataContext.DeleteMemoCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}" />
                        </ContextMenu>
                    </TextBlock.ContextMenu>
                </TextBlock>
                <TextBox x:Name="EditBox"
                         Text="{Binding Title, UpdateSourceTrigger=PropertyChanged}"
                         Padding="{x:Static styles:LayoutConstants.ControlPadding}"
                         HorizontalAlignment="Stretch"
                         BorderThickness="0" Background="Transparent"
                         Visibility="Collapsed"
                         behaviors:FocusBehavior.IsFocused="{Binding IsEditing}">
                    <i:Interaction.Triggers>
                        <i:EventTrigger EventName="LostFocus">
                            <i:InvokeCommandAction Command="{Binding EndEditCommand}" />
                        </i:EventTrigger>
                    </i:Interaction.Triggers>
                </TextBox>
            </Grid>
            <DataTemplate.Triggers>
                <DataTrigger Binding="{Binding IsEditing}" Value="True">
                    <Setter TargetName="DisplayText" Property="Visibility" Value="Collapsed" />
                    <Setter TargetName="EditBox" Property="Visibility" Value="Visible" />
                </DataTrigger>
            </DataTemplate.Triggers>
        </DataTemplate>

        <!-- 右クリックした項目を選択状態にする(削除メニューを選択中の項目に対して動作させるため)。 -->
        <Style x:Key="StretchListBoxItemStyle" TargetType="ListBoxItem">
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <EventSetter Event="PreviewMouseRightButtonDown" Handler="ListBoxItem_PreviewMouseRightButtonDown" />
        </Style>

        <!-- 子TODOは進行中の項目を薄い黄色、完了済みの項目を薄いグレーの背景にする。 -->
        <Style x:Key="ChildTodoListBoxItemStyle" TargetType="ListBoxItem" BasedOn="{StaticResource StretchListBoxItemStyle}">
            <Style.Triggers>
                <DataTrigger Binding="{Binding Status}" Value="InProgress">
                    <Setter Property="Background" Value="LightYellow" />
                </DataTrigger>
                <DataTrigger Binding="{Binding Status}" Value="Done">
                    <Setter Property="Background" Value="LightGray" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
    </UserControl.Resources>

    <TabControl SelectedIndex="{Binding SelectedTabIndex}">
        <!-- 幅が狭い孫項目パネルでもタブ見出しが潰れて選択不能にならないよう折り返す。 -->
        <TabControl.ItemsPanel>
            <ItemsPanelTemplate>
                <WrapPanel />
            </ItemsPanelTemplate>
        </TabControl.ItemsPanel>
        <TabItem Header="{Binding ChildTabHeader}">
            <DockPanel Margin="{x:Static styles:LayoutConstants.TabContentMargin}">
                <!-- 項目のない箇所を右クリックすると追加を表示する。項目自体の右クリックは各項目のContextMenuが優先される。 -->
                <ListBox x:Name="ChildTodoListBox"
                         ItemsSource="{Binding Node.ChildTodoList}"
                         SelectedItem="{Binding SelectedChildTodo}"
                         ItemContainerStyle="{StaticResource ChildTodoListBoxItemStyle}"
                         ItemTemplate="{StaticResource ChildTodoItemTemplate}">
                    <ListBox.ContextMenu>
                        <ContextMenu DataContext="{Binding Path=PlacementTarget.DataContext, RelativeSource={RelativeSource Self}}">
                            <MenuItem Header="{x:Static resx:Strings.Button_Add}" Command="{Binding AddChildTodoCommand}" />
                        </ContextMenu>
                    </ListBox.ContextMenu>
                    <ListBox.InputBindings>
                        <KeyBinding Gesture="Ctrl+Up" Command="{Binding MoveChildTodoUpCommand}" />
                        <KeyBinding Gesture="Ctrl+Down" Command="{Binding MoveChildTodoDownCommand}" />
                    </ListBox.InputBindings>
                </ListBox>
            </DockPanel>
        </TabItem>
        <TabItem Header="{Binding MemoTabHeader}">
            <DockPanel Margin="{x:Static styles:LayoutConstants.TabContentMargin}">
                <!-- 項目のない箇所を右クリックすると追加を表示する。項目自体の右クリックは各項目のContextMenuが優先される。 -->
                <ListBox x:Name="MemoListBox"
                         ItemsSource="{Binding Node.MemoList}"
                         SelectedItem="{Binding SelectedMemo}"
                         ItemContainerStyle="{StaticResource StretchListBoxItemStyle}"
                         ItemTemplate="{StaticResource MemoItemTemplate}">
                    <ListBox.ContextMenu>
                        <ContextMenu DataContext="{Binding Path=PlacementTarget.DataContext, RelativeSource={RelativeSource Self}}">
                            <MenuItem Header="{x:Static resx:Strings.Button_Add}" Command="{Binding AddMemoCommand}" />
                        </ContextMenu>
                    </ListBox.ContextMenu>
                    <ListBox.InputBindings>
                        <KeyBinding Gesture="Ctrl+Up" Command="{Binding MoveMemoUpCommand}" />
                        <KeyBinding Gesture="Ctrl+Down" Command="{Binding MoveMemoDownCommand}" />
                    </ListBox.InputBindings>
                </ListBox>
            </DockPanel>
        </TabItem>
    </TabControl>
</UserControl>
