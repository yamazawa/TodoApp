<UserControl x:Class="TodoApp.Views.TodoListPanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:styles="clr-namespace:TodoApp.Styles"
             xmlns:resx="clr-namespace:TodoApp.Resources"
             xmlns:behaviors="clr-namespace:TodoApp.Behaviors"
             xmlns:i="http://schemas.microsoft.com/xaml/behaviors"
             mc:Ignorable="d"
             x:Name="Root">
    <UserControl.Resources>
        <!-- 子TODOリストのアイテムテンプレート -->
        <!-- 通常はテキスト表示、右クリック「編集」でTextBoxに切り替える -->
        <DataTemplate x:Key="ChildTodoItemTemplate">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <Grid Grid.Column="0">
                    <TextBlock x:Name="DisplayText"
                               Text="{Binding DisplayTitle}"
                               Padding="{x:Static styles:LayoutConstants.ControlPadding}"
                               Tag="{Binding ElementName=Root}">
                        <TextBlock.ContextMenu>
                            <ContextMenu DataContext="{Binding Path=PlacementTarget.DataContext, RelativeSource={RelativeSource Self}}">
                                <MenuItem Header="{x:Static resx:Strings.Menu_Edit}"
                                          Command="{Binding StartEditCommand}" />
                                <MenuItem Header="{x:Static resx:Strings.Menu_Move}"
                                          Command="{Binding Path=PlacementTarget.Tag.NavigateToChildCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                          CommandParameter="{Binding}" />
                                <MenuItem Header="{x:Static resx:Strings.Menu_ConvertToMemo}"
                                          Command="{Binding Path=PlacementTarget.Tag.DataContext.ConvertChildTodoToMemoCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}" />
                            </ContextMenu>
                        </TextBlock.ContextMenu>
                    </TextBlock>
                    <TextBox x:Name="EditBox"
                             Text="{Binding Title, UpdateSourceTrigger=PropertyChanged}"
                             Padding="{x:Static styles:LayoutConstants.ControlPadding}"
                             HorizontalAlignment="Stretch"
                             BorderThickness="0" Background="Transparent"
                             Visibility="Collapsed"
                             behaviors:FocusBehavior.IsFocused="{Binding IsEditing}">
                        <i:Interaction.Triggers>
                            <i:EventTrigger EventName="LostFocus">
                                <i:InvokeCommandAction Command="{Binding EndEditCommand}" />
                            </i:EventTrigger>
                        </i:Interaction.Triggers>
                    </TextBox>
                </Grid>
                <!-- 子TODOへの移動リンク。共通パーツ(TodoDetailEditor)自体には付けず、一覧項目にのみ付ける。 -->
                <Button Grid.Column="1" Content="{x:Static resx:Strings.Button_Move}"
                        Padding="{x:Static styles:LayoutConstants.ButtonPadding}"
                        Command="{Binding NavigateToChildCommand, ElementName=Root}"
                        CommandParameter="{Binding}" />
            </Grid>
            <DataTemplate.Triggers>
                <DataTrigger Binding="{Binding IsEditing}" Value="True">
                    <Setter TargetName="DisplayText" Property="Visibility" Value="Collapsed" />
                    <Setter TargetName="EditBox" Property="Visibility" Value="Visible" />
                </DataTrigger>
            </DataTemplate.Triggers>
        </DataTemplate>

        <!-- メモ情報リストのアイテムテンプレート -->
        <DataTemplate x:Key="MemoItemTemplate">
            <Grid>
                <TextBlock x:Name="DisplayText"
                           Text="{Binding DisplayTitle}"
                           Padding="{x:Static styles:LayoutConstants.ControlPadding}"
                           Tag="{Binding DataContext.ConvertMemoToChildTodoCommand, ElementName=Root}">
                    <TextBlock.ContextMenu>
                        <ContextMenu DataContext="{Binding Path=PlacementTarget.DataContext, RelativeSource={RelativeSource Self}}">
                            <MenuItem Header="{x:Static resx:Strings.Menu_Edit}"
                                      Command="{Binding StartEditCommand}" />
                            <MenuItem Header="{x:Static resx:Strings.Menu_ConvertToChildTodo}"
                                      Command="{Binding Path=PlacementTarget.Tag, RelativeSource={RelativeSource AncestorType=ContextMenu}}" />
                        </ContextMenu>
                    </TextBlock.ContextMenu>
                </TextBlock>
                <TextBox x:Name="EditBox"
                         Text="{Binding Title, UpdateSourceTrigger=PropertyChanged}"
                         Padding="{x:Static styles:LayoutConstants.ControlPadding}"
                         HorizontalAlignment="Stretch"
                         BorderThickness="0" Background="Transparent"
                         Visibility="Collapsed"
                         behaviors:FocusBehavior.IsFocused="{Binding IsEditing}">
                    <i:Interaction.Triggers>
                        <i:EventTrigger EventName="LostFocus">
                            <i:InvokeCommandAction Command="{Binding EndEditCommand}" />
                        </i:EventTrigger>
                    </i:Interaction.Triggers>
                </TextBox>
            </Grid>
            <DataTemplate.Triggers>
                <DataTrigger Binding="{Binding IsEditing}" Value="True">
                    <Setter TargetName="DisplayText" Property="Visibility" Value="Collapsed" />
                    <Setter TargetName="EditBox" Property="Visibility" Value="Visible" />
                </DataTrigger>
            </DataTemplate.Triggers>
        </DataTemplate>

        <Style x:Key="StretchListBoxItemStyle" TargetType="ListBoxItem">
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
        </Style>
    </UserControl.Resources>

    <TabControl SelectedIndex="{Binding SelectedTabIndex}">
        <!-- 幅が狭い孫項目パネルでもタブ見出しが潰れて選択不能にならないよう折り返す。 -->
        <TabControl.ItemsPanel>
            <ItemsPanelTemplate>
                <WrapPanel />
            </ItemsPanelTemplate>
        </TabControl.ItemsPanel>
        <TabItem Header="{Binding ChildTabHeader}">
            <DockPanel Margin="{x:Static styles:LayoutConstants.TabContentMargin}">
                <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal"
                            Margin="{x:Static styles:LayoutConstants.ButtonRowSpacing}">
                    <Button Content="{x:Static resx:Strings.Button_Add}"
                            Padding="{x:Static styles:LayoutConstants.ButtonPadding}"
                            Margin="{x:Static styles:LayoutConstants.ButtonSpacing}"
                            Command="{Binding AddChildTodoCommand}" />
                    <Button Content="{x:Static resx:Strings.Button_Delete}"
                            Padding="{x:Static styles:LayoutConstants.ButtonPadding}"
                            Command="{Binding DeleteChildTodoCommand}" />
                </StackPanel>
                <ListBox x:Name="ChildTodoListBox"
                         ItemsSource="{Binding Node.ChildTodoList}"
                         SelectedItem="{Binding SelectedChildTodo}"
                         ItemContainerStyle="{StaticResource StretchListBoxItemStyle}"
                         ItemTemplate="{StaticResource ChildTodoItemTemplate}">
                    <ListBox.InputBindings>
                        <KeyBinding Gesture="Ctrl+Up" Command="{Binding MoveChildTodoUpCommand}" />
                        <KeyBinding Gesture="Ctrl+Down" Command="{Binding MoveChildTodoDownCommand}" />
                    </ListBox.InputBindings>
                </ListBox>
            </DockPanel>
        </TabItem>
        <TabItem Header="{Binding MemoTabHeader}">
            <DockPanel Margin="{x:Static styles:LayoutConstants.TabContentMargin}">
                <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal"
                            Margin="{x:Static styles:LayoutConstants.ButtonRowSpacing}">
                    <Button Content="{x:Static resx:Strings.Button_Add}"
                            Padding="{x:Static styles:LayoutConstants.ButtonPadding}"
                            Margin="{x:Static styles:LayoutConstants.ButtonSpacing}"
                            Command="{Binding AddMemoCommand}" />
                    <Button Content="{x:Static resx:Strings.Button_Delete}"
                            Padding="{x:Static styles:LayoutConstants.ButtonPadding}"
                            Command="{Binding DeleteMemoCommand}" />
                </StackPanel>
                <ListBox x:Name="MemoListBox"
                         ItemsSource="{Binding Node.MemoList}"
                         SelectedItem="{Binding SelectedMemo}"
                         ItemContainerStyle="{StaticResource StretchListBoxItemStyle}"
                         ItemTemplate="{StaticResource MemoItemTemplate}">
                    <ListBox.InputBindings>
                        <KeyBinding Gesture="Ctrl+Up" Command="{Binding MoveMemoUpCommand}" />
                        <KeyBinding Gesture="Ctrl+Down" Command="{Binding MoveMemoDownCommand}" />
                    </ListBox.InputBindings>
                </ListBox>
            </DockPanel>
        </TabItem>
    </TabControl>
</UserControl>
