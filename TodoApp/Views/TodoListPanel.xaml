<UserControl x:Class="TodoApp.Views.TodoListPanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:styles="clr-namespace:TodoApp.Styles"
             xmlns:resx="clr-namespace:TodoApp.Resources"
             xmlns:behaviors="clr-namespace:TodoApp.Behaviors"
             xmlns:conv="clr-namespace:TodoApp.Converters"
             xmlns:models="clr-namespace:TodoApp.Models"
             xmlns:i="http://schemas.microsoft.com/xaml/behaviors"
             mc:Ignorable="d"
             x:Name="Root">
    <UserControl.Resources>
        <conv:TodoStatusToIconConverter x:Key="TodoStatusToIconConverter" />

        <!-- 状況③のリスト先頭に並べる、選択中NOTEのピン留め表示。タイトルのみ表示し、選択でNOTEモードに切り替える。 -->
        <DataTemplate DataType="{x:Type models:MemoItem}">
            <TextBlock Text="{Binding Title}"
                       FontStyle="Italic"
                       Padding="{x:Static styles:LayoutConstants.ControlPadding}" />
        </DataTemplate>

        <!-- 状況③のリストのTODO項目テンプレート。 -->
        <!-- 通常はテキスト表示、右クリック「編集」でTextBoxに切り替える -->
        <DataTemplate DataType="{x:Type models:TodoItem}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <!-- ステータスアイコン。ダブルクリックで右クリックメニューの「〇〇に変更」と同じ操作を行う。 -->
                <Image Grid.Column="0"
                       Width="{x:Static styles:LayoutConstants.StatusIconSize}"
                       Height="{x:Static styles:LayoutConstants.StatusIconSize}"
                       Margin="{x:Static styles:LayoutConstants.StatusIconMargin}"
                       VerticalAlignment="Center"
                       RenderOptions.BitmapScalingMode="HighQuality"
                       Source="{Binding Status, Converter={StaticResource TodoStatusToIconConverter}}"
                       Tag="{Binding ElementName=Root}">
                    <Image.InputBindings>
                        <MouseBinding Gesture="LeftDoubleClick"
                                      Command="{Binding Path=Tag.DataContext.AdvanceChildTodoStatusCommand, RelativeSource={RelativeSource Self}}"
                                      CommandParameter="{Binding}" />
                    </Image.InputBindings>
                </Image>

                <TextBlock Grid.Column="1" x:Name="DisplayText"
                           Text="{Binding Title}"
                           Padding="{x:Static styles:LayoutConstants.ControlPadding}"
                           Tag="{Binding ElementName=Root}">
                    <TextBlock.ContextMenu>
                        <ContextMenu DataContext="{Binding Path=PlacementTarget.DataContext, RelativeSource={RelativeSource Self}}">
                            <MenuItem Header="{x:Static resx:Strings.Menu_Open}"
                                      Command="{Binding Path=PlacementTarget.Tag.DataContext.OpenChildTodoCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}" />
                            <MenuItem Header="{x:Static resx:Strings.Menu_Edit}"
                                      Command="{Binding StartEditCommand}" />
                            <MenuItem Header="{x:Static resx:Strings.NavigateLink}"
                                      Command="{Binding Path=PlacementTarget.Tag.NavigateToChildCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                      CommandParameter="{Binding}" />
                            <MenuItem Header="{x:Static resx:Strings.Menu_AdvanceToInProgress}"
                                      Command="{Binding Path=PlacementTarget.Tag.DataContext.AdvanceChildTodoStatusCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                      CommandParameter="{Binding}">
                                <MenuItem.Style>
                                    <Style TargetType="MenuItem">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding Status}" Value="NotStarted">
                                                <Setter Property="Visibility" Value="Visible" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </MenuItem.Style>
                            </MenuItem>
                            <MenuItem Header="{x:Static resx:Strings.Menu_AdvanceToDone}"
                                      Command="{Binding Path=PlacementTarget.Tag.DataContext.AdvanceChildTodoStatusCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                      CommandParameter="{Binding}">
                                <MenuItem.Style>
                                    <Style TargetType="MenuItem">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding Status}" Value="InProgress">
                                                <Setter Property="Visibility" Value="Visible" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </MenuItem.Style>
                            </MenuItem>
                            <MenuItem Header="{x:Static resx:Strings.Menu_ConvertToMemo}"
                                      Command="{Binding Path=PlacementTarget.Tag.DataContext.ConvertChildTodoToMemoCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}" />
                            <MenuItem Header="{x:Static resx:Strings.Button_Delete}"
                                      Command="{Binding Path=PlacementTarget.Tag.DataContext.DeleteChildTodoCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}" />
                        </ContextMenu>
                    </TextBlock.ContextMenu>
                </TextBlock>
                <TextBox Grid.Column="1" x:Name="EditBox"
                         Text="{Binding Title, UpdateSourceTrigger=PropertyChanged}"
                         Padding="{x:Static styles:LayoutConstants.ControlPadding}"
                         HorizontalAlignment="Stretch"
                         BorderThickness="0" Background="Transparent"
                         Visibility="Collapsed"
                         behaviors:FocusBehavior.IsFocused="{Binding IsEditing}"
                         behaviors:RevertOnLostFocusBehavior.IsEnabled="True">
                    <i:Interaction.Triggers>
                        <i:EventTrigger EventName="LostFocus">
                            <i:InvokeCommandAction Command="{Binding EndEditCommand}" />
                        </i:EventTrigger>
                    </i:Interaction.Triggers>
                </TextBox>
            </Grid>
            <DataTemplate.Triggers>
                <DataTrigger Binding="{Binding IsEditing}" Value="True">
                    <Setter TargetName="DisplayText" Property="Visibility" Value="Collapsed" />
                    <Setter TargetName="EditBox" Property="Visibility" Value="Visible" />
                </DataTrigger>
            </DataTemplate.Triggers>
        </DataTemplate>

        <!-- 右クリックした項目を選択状態にする(削除メニューを選択中の項目に対して動作させるため)。 -->
        <Style x:Key="StretchListBoxItemStyle" TargetType="ListBoxItem">
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <EventSetter Event="PreviewMouseRightButtonDown" Handler="ListBoxItem_PreviewMouseRightButtonDown" />
        </Style>
    </UserControl.Resources>

    <!-- 状況③ : 子TODOが1件以上。先頭に選択中NOTE、以降にTODOを順に表示する。 -->
    <!-- 項目のない箇所を右クリックすると追加を表示する。項目自体の右クリックは各項目のContextMenuが優先される。 -->
    <ListBox x:Name="ChildTodoListBox"
             Margin="{x:Static styles:LayoutConstants.TabContentMargin}"
             ItemsSource="{Binding ListEntries}"
             SelectedItem="{Binding SelectedEntry}"
             ItemContainerStyle="{StaticResource StretchListBoxItemStyle}">
        <ListBox.ContextMenu>
            <ContextMenu DataContext="{Binding Path=PlacementTarget.DataContext, RelativeSource={RelativeSource Self}}">
                <MenuItem Header="{x:Static resx:Strings.Button_Add}" Command="{Binding AddChildTodoCommand}" />
            </ContextMenu>
        </ListBox.ContextMenu>
        <ListBox.InputBindings>
            <KeyBinding Gesture="Ctrl+Up" Command="{Binding MoveChildTodoUpCommand}" />
            <KeyBinding Gesture="Ctrl+Down" Command="{Binding MoveChildTodoDownCommand}" />
        </ListBox.InputBindings>
    </ListBox>
</UserControl>
