<UserControl x:Class="TodoApp.Views.TodoFramePanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:styles="clr-namespace:TodoApp.Styles"
             xmlns:resx="clr-namespace:TodoApp.Resources"
             xmlns:conv="clr-namespace:TodoApp.Converters"
             xmlns:views="clr-namespace:TodoApp.Views"
             mc:Ignorable="d"
             x:Name="Root">
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter" />
        <conv:ListWidthToGridLengthConverter x:Key="ListWidthToGridLengthConverter" />
    </UserControl.Resources>
    <Grid>
        <!-- 状況① : 子TODO0件、メモ1件 → リストなしで選択中メモを直接表示する。 -->
        <DockPanel Visibility="{Binding IsListless, Converter={StaticResource BooleanToVisibilityConverter}}">
            <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" Margin="{x:Static styles:LayoutConstants.FieldSpacing}">
                <Button Content="{x:Static resx:Strings.Button_AddTodoList}"
                        Margin="{x:Static styles:LayoutConstants.ButtonSpacing}"
                        Command="{Binding AddChildTodoCommand}" />
                <Button Content="{x:Static resx:Strings.Button_ConvertToMemoList}"
                        Command="{Binding AddMemoCommand}" />
            </StackPanel>
            <views:TodoDetailEditor Title="{Binding SelectedMemo.Title}"
                                     Body="{Binding SelectedMemo.Body}" />
        </DockPanel>

        <!-- 状況②③ : 左にリスト、右に詳細(または再帰的なTODOリスト表示)。 -->
        <Grid Visibility="{Binding HasList, Converter={StaticResource BooleanToVisibilityConverter}}">
            <Grid.ColumnDefinitions>
                <!-- リストは表示横幅(TODO単位の表示情報)を優先し、nullなら内容に合わせて自動サイズにする。 -->
                <ColumnDefinition x:Name="LeftColumn" MinWidth="{x:Static styles:LayoutConstants.MinSplitPaneWidth}"
                                  Width="{Binding ListWidth, Converter={StaticResource ListWidthToGridLengthConverter}}" />
                <ColumnDefinition Width="{x:Static styles:LayoutConstants.SplitterThickness}" />
                <ColumnDefinition x:Name="RightColumn" MinWidth="{x:Static styles:LayoutConstants.MinSplitPaneWidth}" Width="*" />
            </Grid.ColumnDefinitions>

            <views:TodoListPanel Grid.Column="0" DataContext="{Binding}"
                                 NavigateToChildCommand="{Binding DataContext.NavigateToChildCommand, RelativeSource={RelativeSource AncestorType=Window}}" />

            <GridSplitter Grid.Column="1" HorizontalAlignment="Stretch" VerticalAlignment="Stretch"
                          ResizeDirection="Columns" Background="Transparent"
                          DragDelta="ListDetailSplitter_DragDelta" />

            <Grid Grid.Column="2" Margin="{x:Static styles:LayoutConstants.TabContentMargin}">
                <!-- NOTEリスト選択時(状況③)、または状況②で常に、選択中メモを表示する。 -->
                <views:TodoDetailEditor Visibility="{Binding ShowMemoDetail, Converter={StaticResource BooleanToVisibilityConverter}}"
                                         Title="{Binding SelectedMemo.Title}"
                                         Body="{Binding SelectedMemo.Body}" />
                <!-- TODOリスト選択時(状況③)、選択中TODOを本レイアウトで再帰的に表示する。 -->
                <!-- 子パネルの生成・破棄はコードビハインドでDispatcher遅延して行う(TodoFramePanel.xaml.cs参照)。 -->
                <ContentControl x:Name="ChildFrameHost"
                                Visibility="{Binding ShowChildFrame, Converter={StaticResource BooleanToVisibilityConverter}}" />
            </Grid>
        </Grid>
    </Grid>
</UserControl>
