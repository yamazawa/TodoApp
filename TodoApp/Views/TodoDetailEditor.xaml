<UserControl x:Class="TodoApp.Views.TodoDetailEditor"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:styles="clr-namespace:TodoApp.Styles"
             mc:Ignorable="d"
             x:Name="Root">
    <TextBox Padding="{x:Static styles:LayoutConstants.ControlPadding}"
             AcceptsReturn="True" TextWrapping="Wrap"
             VerticalScrollBarVisibility="Auto"
             Text="{Binding Body, ElementName=Root, UpdateSourceTrigger=PropertyChanged}" />
</UserControl>
