<Window x:Class="TodoApp.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:TodoApp"
        xmlns:styles="clr-namespace:TodoApp.Styles"
        xmlns:resx="clr-namespace:TodoApp.Resources"
        xmlns:behaviors="clr-namespace:TodoApp.Behaviors"
        xmlns:views="clr-namespace:TodoApp.Views"
        xmlns:conv="clr-namespace:TodoApp.Converters"
        xmlns:vm="clr-namespace:TodoApp.ViewModels"
        xmlns:i="http://schemas.microsoft.com/xaml/behaviors"
        mc:Ignorable="d"
        Title="{x:Static resx:Strings.WindowTitle}"
        Height="{Binding WindowHeight, Mode=TwoWay}"
        Width="{Binding WindowWidth, Mode=TwoWay}"
        MinHeight="{x:Static styles:LayoutConstants.WindowMinHeight}"
        MinWidth="{x:Static styles:LayoutConstants.WindowMinWidth}">
    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter" />
        <conv:RatioToGridLengthConverter x:Key="RatioToGridLengthConverter" />
    </Window.Resources>
    <Grid Margin="{x:Static styles:LayoutConstants.RootMargin}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="{Binding TopBottomRatio, Converter={StaticResource RatioToGridLengthConverter}}" />
            <RowDefinition Height="{x:Static styles:LayoutConstants.SplitterThickness}" />
            <RowDefinition Height="{Binding TopBottomRatio, Converter={StaticResource RatioToGridLengthConverter}, ConverterParameter=Invert}" />
        </Grid.RowDefinitions>

        <!-- パンくずリスト : 親TODOへのリンク。祖先が無ければ何も表示しない。 -->
        <ItemsControl Grid.Row="0" Margin="{x:Static styles:LayoutConstants.FieldSpacing}"
                      ItemsSource="{Binding Breadcrumbs}">
            <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate>
                    <StackPanel Orientation="Horizontal" />
                </ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
            <ItemsControl.ItemTemplate>
                <DataTemplate>
                    <StackPanel Orientation="Horizontal">
                        <Button Content="{Binding Label}"
                                Padding="0" BorderThickness="0" Background="Transparent"
                                Foreground="Blue" Cursor="Hand"
                                Command="{Binding DataContext.NavigateToBreadcrumbCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                CommandParameter="{Binding}" />
                        <TextBlock Text=" / " />
                    </StackPanel>
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>

        <!-- 上半分 : タイトル/ステータス/本文 -->
        <views:TodoDetailEditor Grid.Row="1" Margin="{x:Static styles:LayoutConstants.SectionSpacing}"
                                 Title="{Binding SelectedTodo.Title}"
                                 DisplayTitle="{Binding SelectedTodo.DisplayTitle}"
                                 Status="{Binding SelectedTodo.Status}"
                                 Body="{Binding SelectedTodo.Body}"
                                 StatusOptions="{x:Static vm:TodoNodeViewModel.StatusOptions}"
                                 ShowStatus="True" />

        <GridSplitter Grid.Row="2" HorizontalAlignment="Stretch" VerticalAlignment="Stretch"
                      ResizeDirection="Rows" Background="Transparent" />

        <!-- 下半分 : 左側(子TODO/メモ情報の一覧) / 右側(選択項目の詳細) -->
        <Grid Grid.Row="3">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="{Binding BottomLeftRightRatio, Converter={StaticResource RatioToGridLengthConverter}}" />
                <ColumnDefinition Width="{x:Static styles:LayoutConstants.SplitterThickness}" />
                <ColumnDefinition Width="{Binding BottomLeftRightRatio, Converter={StaticResource RatioToGridLengthConverter}, ConverterParameter=Invert}" />
            </Grid.ColumnDefinitions>

            <views:TodoListPanel Grid.Column="0" DataContext="{Binding RootNode}"
                                 NavigateToChildCommand="{Binding DataContext.NavigateToChildCommand, RelativeSource={RelativeSource AncestorType=Window}}" />

            <GridSplitter Grid.Column="1" HorizontalAlignment="Stretch" VerticalAlignment="Stretch"
                          ResizeDirection="Columns" Background="Transparent" />

            <!-- 下半分の右側 : 選択中の子TODO(孫項目パネル込み)/メモ情報の詳細 -->
            <Grid Grid.Column="2" Margin="{x:Static styles:LayoutConstants.TabContentMargin}">
                <!-- 子TODOタブ選択時 : 画面全体と同様に、上にタイトル・左下に孫項目リスト・右下に孫項目詳細を表示する。 -->
                <Grid Visibility="{Binding RootNode.IsChildTabSelected, Converter={StaticResource BooleanToVisibilityConverter}}">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="{Binding NestedTopBottomRatio, Converter={StaticResource RatioToGridLengthConverter}}" />
                        <RowDefinition Height="{x:Static styles:LayoutConstants.SplitterThickness}" />
                        <RowDefinition Height="{Binding NestedTopBottomRatio, Converter={StaticResource RatioToGridLengthConverter}, ConverterParameter=Invert}" />
                    </Grid.RowDefinitions>

                    <views:TodoDetailEditor Grid.Row="0" Margin="{x:Static styles:LayoutConstants.SectionSpacing}"
                                             Title="{Binding RootNode.SelectedChildTodo.Title}"
                                             DisplayTitle="{Binding RootNode.SelectedChildTodo.DisplayTitle}"
                                             Status="{Binding RootNode.SelectedChildTodo.Status}"
                                             Body="{Binding RootNode.SelectedChildTodo.Body}"
                                             StatusOptions="{x:Static vm:TodoNodeViewModel.StatusOptions}"
                                             ShowStatus="True" />

                    <GridSplitter Grid.Row="1" HorizontalAlignment="Stretch" VerticalAlignment="Stretch"
                                  ResizeDirection="Rows" Background="Transparent" />

                    <Grid Grid.Row="2">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="{Binding NestedLeftRightRatio, Converter={StaticResource RatioToGridLengthConverter}}" />
                            <ColumnDefinition Width="{x:Static styles:LayoutConstants.SplitterThickness}" />
                            <ColumnDefinition Width="{Binding NestedLeftRightRatio, Converter={StaticResource RatioToGridLengthConverter}, ConverterParameter=Invert}" />
                        </Grid.ColumnDefinitions>

                        <views:TodoListPanel Grid.Column="0" DataContext="{Binding ChildNode}"
                                             NavigateToChildCommand="{Binding DataContext.NavigateToChildCommand, RelativeSource={RelativeSource AncestorType=Window}}" />

                        <GridSplitter Grid.Column="1" HorizontalAlignment="Stretch" VerticalAlignment="Stretch"
                                      ResizeDirection="Columns" Background="Transparent" />

                        <!-- 孫項目詳細 : TODO項目は完了数/総数も表示し、これ以上は再帰しない簡易表示に留める。 -->
                        <Grid Grid.Column="2" Margin="{x:Static styles:LayoutConstants.TabContentMargin}">
                            <views:TodoDetailEditor Visibility="{Binding ChildNode.IsChildTabSelected, Converter={StaticResource BooleanToVisibilityConverter}}"
                                                     Title="{Binding ChildNode.SelectedChildTodo.Title}"
                                                     DisplayTitle="{Binding ChildNode.SelectedChildTodo.DisplayTitle}"
                                                     Status="{Binding ChildNode.SelectedChildTodo.Status}"
                                                     Body="{Binding ChildNode.SelectedChildTodo.Body}"
                                                     ChildCountText="{Binding ChildNode.SelectedChildTodo.ChildCountText}"
                                                     StatusOptions="{x:Static vm:TodoNodeViewModel.StatusOptions}"
                                                     ShowStatus="True" />
                            <views:TodoDetailEditor Visibility="{Binding ChildNode.IsMemoTabSelected, Converter={StaticResource BooleanToVisibilityConverter}}"
                                                     Title="{Binding ChildNode.SelectedMemo.Title}"
                                                     DisplayTitle="{Binding ChildNode.SelectedMemo.DisplayTitle}"
                                                     Body="{Binding ChildNode.SelectedMemo.Body}"
                                                     ShowStatus="False" />
                        </Grid>
                    </Grid>
                </Grid>

                <!-- メモ情報タブ選択時 -->
                <views:TodoDetailEditor Visibility="{Binding RootNode.IsMemoTabSelected, Converter={StaticResource BooleanToVisibilityConverter}}"
                                         Title="{Binding RootNode.SelectedMemo.Title}"
                                         DisplayTitle="{Binding RootNode.SelectedMemo.DisplayTitle}"
                                         Body="{Binding RootNode.SelectedMemo.Body}"
                                         ShowStatus="False" />
            </Grid>
        </Grid>
    </Grid>
</Window>
