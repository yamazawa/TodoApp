<Window x:Class="TodoApp.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:TodoApp"
        xmlns:styles="clr-namespace:TodoApp.Styles"
        xmlns:resx="clr-namespace:TodoApp.Resources"
        xmlns:behaviors="clr-namespace:TodoApp.Behaviors"
        xmlns:views="clr-namespace:TodoApp.Views"
        xmlns:i="http://schemas.microsoft.com/xaml/behaviors"
        mc:Ignorable="d"
        Title="{x:Static resx:Strings.WindowTitle}"
        Height="{x:Static styles:LayoutConstants.WindowHeight}"
        Width="{x:Static styles:LayoutConstants.WindowWidth}"
        MinHeight="{x:Static styles:LayoutConstants.WindowMinHeight}"
        MinWidth="{x:Static styles:LayoutConstants.WindowMinWidth}">
    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter" />

        <!-- 子TODO/メモ情報リストの共通アイテムテンプレート -->
        <!-- 通常はテキスト表示、右クリック「編集」でTextBoxに切り替える -->
        <DataTemplate x:Key="EditableListItemTemplate">
            <Grid>
                <TextBlock x:Name="DisplayText"
                           Text="{Binding DisplayTitle}"
                           Padding="{x:Static styles:LayoutConstants.ControlPadding}">
                    <TextBlock.ContextMenu>
                        <ContextMenu DataContext="{Binding Path=PlacementTarget.DataContext, RelativeSource={RelativeSource Self}}">
                            <MenuItem Header="{x:Static resx:Strings.Menu_Edit}"
                                      Command="{Binding StartEditCommand}" />
                        </ContextMenu>
                    </TextBlock.ContextMenu>
                </TextBlock>
                <TextBox x:Name="EditBox"
                         Text="{Binding Title, UpdateSourceTrigger=PropertyChanged}"
                         Padding="{x:Static styles:LayoutConstants.ControlPadding}"
                         HorizontalAlignment="Stretch"
                         BorderThickness="0" Background="Transparent"
                         Visibility="Collapsed"
                         behaviors:FocusBehavior.IsFocused="{Binding IsEditing}">
                    <i:Interaction.Triggers>
                        <i:EventTrigger EventName="LostFocus">
                            <i:InvokeCommandAction Command="{Binding EndEditCommand}" />
                        </i:EventTrigger>
                    </i:Interaction.Triggers>
                </TextBox>
            </Grid>
            <DataTemplate.Triggers>
                <DataTrigger Binding="{Binding IsEditing}" Value="True">
                    <Setter TargetName="DisplayText" Property="Visibility" Value="Collapsed" />
                    <Setter TargetName="EditBox" Property="Visibility" Value="Visible" />
                </DataTrigger>
            </DataTemplate.Triggers>
        </DataTemplate>

        <Style x:Key="StretchListBoxItemStyle" TargetType="ListBoxItem">
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
        </Style>
    </Window.Resources>
    <Grid Margin="{x:Static styles:LayoutConstants.RootMargin}">
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- 上半分 : タイトル/ステータス/本文 -->
        <views:TodoDetailEditor Grid.Row="0" Margin="{x:Static styles:LayoutConstants.SectionSpacing}"
                                 Title="{Binding SelectedTodo.Title}"
                                 Status="{Binding SelectedTodo.Status}"
                                 Body="{Binding SelectedTodo.Body}"
                                 StatusOptions="{Binding StatusOptions}"
                                 ShowStatus="True" />

        <!-- 下半分 : 左側(子TODO/メモ情報の一覧) / 右側(選択項目の詳細) -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="{x:Static styles:LayoutConstants.BottomLeftColumnWidth}" />
                <ColumnDefinition Width="{x:Static styles:LayoutConstants.BottomRightColumnWidth}" />
            </Grid.ColumnDefinitions>

            <TabControl Grid.Column="0" SelectedIndex="{Binding SelectedTabIndex}">
                <TabItem Header="{x:Static resx:Strings.Tab_ChildTodo}">
                    <DockPanel Margin="{x:Static styles:LayoutConstants.TabContentMargin}">
                        <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal"
                                    Margin="{x:Static styles:LayoutConstants.ButtonRowSpacing}">
                            <Button Content="{x:Static resx:Strings.Button_Add}"
                                    Padding="{x:Static styles:LayoutConstants.ButtonPadding}"
                                    Margin="{x:Static styles:LayoutConstants.ButtonSpacing}"
                                    Command="{Binding AddChildTodoCommand}" />
                            <Button Content="{x:Static resx:Strings.Button_Delete}"
                                    Padding="{x:Static styles:LayoutConstants.ButtonPadding}"
                                    Command="{Binding DeleteChildTodoCommand}" />
                        </StackPanel>
                        <ListBox x:Name="ChildTodoListBox"
                                 ItemsSource="{Binding SelectedTodo.ChildTodoList}"
                                 SelectedItem="{Binding SelectedChildTodo}"
                                 ItemContainerStyle="{StaticResource StretchListBoxItemStyle}"
                                 ItemTemplate="{StaticResource EditableListItemTemplate}">
                            <ListBox.InputBindings>
                                <KeyBinding Gesture="Ctrl+Up" Command="{Binding MoveChildTodoUpCommand}" />
                                <KeyBinding Gesture="Ctrl+Down" Command="{Binding MoveChildTodoDownCommand}" />
                            </ListBox.InputBindings>
                        </ListBox>
                    </DockPanel>
                </TabItem>
                <TabItem Header="{x:Static resx:Strings.Tab_Memo}">
                    <DockPanel Margin="{x:Static styles:LayoutConstants.TabContentMargin}">
                        <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal"
                                    Margin="{x:Static styles:LayoutConstants.ButtonRowSpacing}">
                            <Button Content="{x:Static resx:Strings.Button_Add}"
                                    Padding="{x:Static styles:LayoutConstants.ButtonPadding}"
                                    Margin="{x:Static styles:LayoutConstants.ButtonSpacing}"
                                    Command="{Binding AddMemoCommand}" />
                            <Button Content="{x:Static resx:Strings.Button_Delete}"
                                    Padding="{x:Static styles:LayoutConstants.ButtonPadding}"
                                    Command="{Binding DeleteMemoCommand}" />
                        </StackPanel>
                        <ListBox x:Name="MemoListBox"
                                 ItemsSource="{Binding SelectedTodo.MemoList}"
                                 SelectedItem="{Binding SelectedMemo}"
                                 ItemContainerStyle="{StaticResource StretchListBoxItemStyle}"
                                 ItemTemplate="{StaticResource EditableListItemTemplate}">
                            <ListBox.InputBindings>
                                <KeyBinding Gesture="Ctrl+Up" Command="{Binding MoveMemoUpCommand}" />
                                <KeyBinding Gesture="Ctrl+Down" Command="{Binding MoveMemoDownCommand}" />
                            </ListBox.InputBindings>
                        </ListBox>
                    </DockPanel>
                </TabItem>
            </TabControl>

            <!-- 下半分の右側 : 選択中の子TODO/メモ情報の詳細(孫項目リストは未実装) -->
            <Grid Grid.Column="1" Margin="{x:Static styles:LayoutConstants.TabContentMargin}">
                <views:TodoDetailEditor Visibility="{Binding IsChildTabSelected, Converter={StaticResource BooleanToVisibilityConverter}}"
                                         Title="{Binding SelectedChildTodo.Title}"
                                         Status="{Binding SelectedChildTodo.Status}"
                                         Body="{Binding SelectedChildTodo.Body}"
                                         StatusOptions="{Binding StatusOptions}"
                                         ShowStatus="True" />
                <views:TodoDetailEditor Visibility="{Binding IsMemoTabSelected, Converter={StaticResource BooleanToVisibilityConverter}}"
                                         Title="{Binding SelectedMemo.Title}"
                                         Body="{Binding SelectedMemo.Body}"
                                         ShowStatus="False" />
            </Grid>
        </Grid>
    </Grid>
</Window>
