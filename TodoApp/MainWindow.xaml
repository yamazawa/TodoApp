<Window x:Class="TodoApp.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:TodoApp"
        xmlns:styles="clr-namespace:TodoApp.Styles"
        xmlns:resx="clr-namespace:TodoApp.Resources"
        xmlns:conv="clr-namespace:TodoApp.Converters"
        mc:Ignorable="d"
        Title="{x:Static resx:Strings.WindowTitle}"
        Height="{x:Static styles:LayoutConstants.WindowHeight}"
        Width="{x:Static styles:LayoutConstants.WindowWidth}"
        MinHeight="{x:Static styles:LayoutConstants.WindowMinHeight}"
        MinWidth="{x:Static styles:LayoutConstants.WindowMinWidth}">
    <Window.Resources>
        <conv:TodoStatusToStringConverter x:Key="TodoStatusToStringConverter" />

        <!-- 子TODO/メモ情報リストの共通アイテムテンプレート -->
        <!-- 通常はテキスト表示、右クリック「編集」でTextBoxに切り替える -->
        <DataTemplate x:Key="EditableListItemTemplate">
            <Grid>
                <TextBlock x:Name="DisplayText"
                           Text="{Binding DisplayTitle}"
                           Padding="{x:Static styles:LayoutConstants.ControlPadding}">
                    <TextBlock.ContextMenu>
                        <ContextMenu>
                            <MenuItem Header="{x:Static resx:Strings.Menu_Edit}"
                                      Click="EditMenuItem_Click"
                                      CommandParameter="{Binding Path=PlacementTarget.DataContext, RelativeSource={RelativeSource AncestorType=ContextMenu}}" />
                        </ContextMenu>
                    </TextBlock.ContextMenu>
                </TextBlock>
                <TextBox x:Name="EditBox"
                         Text="{Binding Title, UpdateSourceTrigger=PropertyChanged}"
                         Padding="{x:Static styles:LayoutConstants.ControlPadding}"
                         HorizontalAlignment="Stretch"
                         BorderThickness="0" Background="Transparent"
                         Visibility="Collapsed"
                         LostFocus="EditTextBox_LostFocus"
                         IsVisibleChanged="EditTextBox_IsVisibleChanged" />
            </Grid>
            <DataTemplate.Triggers>
                <DataTrigger Binding="{Binding IsEditing}" Value="True">
                    <Setter TargetName="DisplayText" Property="Visibility" Value="Collapsed" />
                    <Setter TargetName="EditBox" Property="Visibility" Value="Visible" />
                </DataTrigger>
            </DataTemplate.Triggers>
        </DataTemplate>

        <Style x:Key="StretchListBoxItemStyle" TargetType="ListBoxItem">
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
        </Style>
    </Window.Resources>
    <Grid Margin="{x:Static styles:LayoutConstants.RootMargin}">
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- 上半分 : タイトル/ステータス/本文 -->
        <Grid Grid.Row="0" Margin="{x:Static styles:LayoutConstants.SectionSpacing}">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>
            <TextBox Grid.Row="0" Margin="{x:Static styles:LayoutConstants.FieldSpacing}"
                     Padding="{x:Static styles:LayoutConstants.ControlPadding}"
                     Text="{Binding SelectedTodo.Title, UpdateSourceTrigger=PropertyChanged}" />
            <ComboBox Grid.Row="1" Margin="{x:Static styles:LayoutConstants.FieldSpacing}"
                      MinWidth="100" HorizontalAlignment="Left"
                      ItemsSource="{Binding StatusOptions}"
                      SelectedItem="{Binding SelectedTodo.Status}">
                <ComboBox.ItemTemplate>
                    <DataTemplate>
                        <TextBlock Text="{Binding Converter={StaticResource TodoStatusToStringConverter}}" />
                    </DataTemplate>
                </ComboBox.ItemTemplate>
            </ComboBox>
            <TextBox Grid.Row="2" Padding="{x:Static styles:LayoutConstants.ControlPadding}"
                     AcceptsReturn="True" TextWrapping="Wrap"
                     VerticalScrollBarVisibility="Auto"
                     Text="{Binding SelectedTodo.Body, UpdateSourceTrigger=PropertyChanged}" />
        </Grid>

        <!-- 下半分 : 子TODO/メモ情報 -->
        <TabControl Grid.Row="1">
            <TabItem Header="{x:Static resx:Strings.Tab_ChildTodo}">
                <DockPanel Margin="{x:Static styles:LayoutConstants.TabContentMargin}">
                    <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal"
                                Margin="{x:Static styles:LayoutConstants.ButtonRowSpacing}">
                        <Button Content="{x:Static resx:Strings.Button_Add}"
                                Padding="{x:Static styles:LayoutConstants.ButtonPadding}"
                                Margin="{x:Static styles:LayoutConstants.ButtonSpacing}"
                                Command="{Binding AddChildTodoCommand}" />
                        <Button Content="{x:Static resx:Strings.Button_Delete}"
                                Padding="{x:Static styles:LayoutConstants.ButtonPadding}"
                                Command="{Binding DeleteChildTodoCommand}"
                                CommandParameter="{Binding ElementName=ChildTodoListBox, Path=SelectedItem}" />
                    </StackPanel>
                    <ListBox x:Name="ChildTodoListBox"
                             ItemsSource="{Binding SelectedTodo.ChildTodoList}"
                             ItemContainerStyle="{StaticResource StretchListBoxItemStyle}"
                             ItemTemplate="{StaticResource EditableListItemTemplate}" />
                </DockPanel>
            </TabItem>
            <TabItem Header="{x:Static resx:Strings.Tab_Memo}">
                <DockPanel Margin="{x:Static styles:LayoutConstants.TabContentMargin}">
                    <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal"
                                Margin="{x:Static styles:LayoutConstants.ButtonRowSpacing}">
                        <Button Content="{x:Static resx:Strings.Button_Add}"
                                Padding="{x:Static styles:LayoutConstants.ButtonPadding}"
                                Margin="{x:Static styles:LayoutConstants.ButtonSpacing}"
                                Command="{Binding AddMemoCommand}" />
                        <Button Content="{x:Static resx:Strings.Button_Delete}"
                                Padding="{x:Static styles:LayoutConstants.ButtonPadding}"
                                Command="{Binding DeleteMemoCommand}"
                                CommandParameter="{Binding ElementName=MemoListBox, Path=SelectedItem}" />
                    </StackPanel>
                    <ListBox x:Name="MemoListBox"
                             ItemsSource="{Binding SelectedTodo.MemoList}"
                             ItemContainerStyle="{StaticResource StretchListBoxItemStyle}"
                             ItemTemplate="{StaticResource EditableListItemTemplate}" />
                </DockPanel>
            </TabItem>
        </TabControl>
    </Grid>
</Window>
